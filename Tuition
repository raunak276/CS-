// Export to CSV/Excel using Blob (Mobile Supported)
function exportToCSV() {
    if(students.length === 0) { showToast("No data to export", "error"); return; }
    let csvContent = "Name,Class,Phone,Expected Fee,Total Paid,Due Amount\n";
    students.forEach(s => {
        const pd = (payments[s.id]||[]).reduce((x,y)=>x+y.amount,0); const due = Math.max(0, (s.fee||0)-pd);
        csvContent += `"${s.name}","${s.class||''}","${s.phone||''}","${s.fee||0}","${pd}","${due}"\n`;
    });
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a"); link.setAttribute("href", url); link.setAttribute("download", "ChandanSir_Students_Data.csv");
    document.body.appendChild(link); link.click(); document.body.removeChild(link); URL.revokeObjectURL(url);
    showToast("Excel File Downloaded!");
}

// ID Card Generator
function showIDCard(event, id) {
    event.stopPropagation();
    const s = students.find(x=>x.id===id); if(!s) return;
    document.getElementById('idCardName').textContent = s.name.toUpperCase();
    document.getElementById('idCardClass').textContent = 'Class: ' + (s.class || 'N/A');
    const logoImg = document.getElementById('idCardLogo');
    if(savedLogo) { logoImg.src = savedLogo; logoImg.style.display = 'block'; }
    document.getElementById('idCardModal').classList.add('active');
}

// App Initialization
window.addEventListener('load', () => {
    setTimeout(() => {
        document.getElementById('splashScreen').classList.add('hidden');
        if (localStorage.getItem('tc_logged') === 'true') showApp();
        else document.getElementById('loginScreen').classList.add('active');
    }, 2000);
});

function login() {
    if(document.getElementById('loginPassword').value === appPassword) {
        localStorage.setItem('tc_logged', 'true'); showApp(); showToast('Access Granted');
    } else showToast('Access Denied', 'error');
}
function logout() { localStorage.removeItem('tc_logged'); location.reload(); }

function showApp() {
    document.getElementById('loginScreen').classList.remove('active'); document.getElementById('mainApp').classList.add('active');
    document.getElementById('paymentDate').value = new Date().toISOString().split('T')[0];
    const cm = new Date(); document.getElementById('reportMonth').value = cm.getFullYear() + '-' + String(cm.getMonth()+1).padStart(2, '0');
    // Data is loaded from Firebase automatically
}

function toggleTheme() { document.body.classList.toggle('dark-mode'); localStorage.setItem('tc_theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); }
function showToast(msg, type='success') { const c = document.getElementById('toastContainer'); const t = document.createElement('div'); t.className = 'toast ' + type; t.textContent = msg; c.appendChild(t); setTimeout(() => t.remove(), 3000); }

function switchTab(tab) {
    document.querySelectorAll('.tab-content, .nav-item').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    const map = {dashboard:0, students:1, attendance:2, fees:3, reports:4, settings:5};
    document.querySelectorAll('.nav-item')[map[tab]].classList.add('active');
    if(tab==='dashboard') updateDashboard(); if(tab==='students') loadStudentsList();
    if(['attendance','fees','reports'].includes(tab)) updateSelects();
}

function updateDashboard() {
    document.getElementById('totalStudents').textContent = students.length;
    let p=0, a=0, d=0; const today = new Date().toISOString().split('T')[0];
    students.forEach(s => {
        const at = attendance[s.id] || {}; if(at[today]==='present') p++; else if(at[today]==='absent') a++;
        const pd = (payments[s.id]||[]).reduce((x,y)=>x+y.amount,0); if((s.fee||0)>pd) d++;
    });
    document.getElementById('todayPresent').textContent = p; document.getElementById('todayAbsent').textContent = a; document.getElementById('feesDue').textContent = d;
    const log = document.getElementById('recentActivity');
    log.innerHTML = activityLog.slice(0,6).map(act => `<div style="padding:10px 0;border-bottom:1px solid var(--border)"><b>${act.text}</b> <br><span style="font-size:0.7rem;color:var(--gray)">${new Date(act.time).toLocaleString()}</span></div>`).join('') || 'Log clear';
}

function logAct(txt) { activityLog.unshift({text:txt, time:new Date().toISOString()}); if(activityLog.length>30) activityLog.pop(); syncToCloud(); }

function loadStudentsList() {
    const q = document.getElementById('studentSearch').value.toLowerCase();
    const list = students.filter(s => s.name.toLowerCase().includes(q));
    const c = document.getElementById('studentsList');
    if(!list.length) { c.innerHTML = '<div style="text-align:center;padding:20px;color:var(--gray)">No intel found</div>'; return; }
    
    c.innerHTML = list.map(s => {
        const pd = (payments[s.id]||[]).reduce((x,y)=>x+y.amount,0); const due = (s.fee||0)-pd;
        let wa = s.phone ? `<a href="https://wa.me/91${s.phone.replace(/\D/g,'')}?text=System%20Alert:%20" target="_blank" class="whatsapp-btn" onclick="event.stopPropagation()">WhatsApp Comms</a>` : '';
        let idBtn = `<button class="id-btn" onclick="showIDCard(event, '${s.id}')">🪪 View ID</button>`;
        let nts = s.notes ? `<div style="background:var(--app-bg);padding:10px;border-radius:10px;margin-top:10px;font-size:0.8rem;border-left:3px solid var(--warning)">⚠️ ${s.notes}</div>` : '';
        
        return `<div class="student-item" onclick="openEditStudent('${s.id}')">
            <div style="display:flex;align-items:center;gap:15px">
                <div style="width:45px;height:45px;background:var(--primary);color:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:1.2rem">${s.name.charAt(0)}</div>
                <div><h4 style="font-size:1.1rem;font-weight:800">${s.name}</h4><p style="font-size:0.8rem;color:var(--gray)">[${s.class||'N/A'}] Base Fee: ₹${s.fee||0}</p></div>
            </div>
            <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">${due>0 ? `<span class="badge" style="background:var(--danger);color:#fff">Deficit: ₹${due}</span>` : `<span class="badge" style="background:var(--success);color:#fff">Cleared</span>`} ${wa} ${idBtn}</div>
            ${nts}
        </div>`;
    }).join('');
}

function searchStudents() { loadStudentsList(); }
function openAddStudent() { ['Name','Class','Phone','Fee','Notes','EditId'].forEach(i => document.getElementById('student'+i).value=''); document.getElementById('deleteStudentBtn').style.display='none'; document.getElementById('addStudentModal').classList.add('active'); }
function openEditStudent(id) {
    const s = students.find(x=>x.id===id); if(!s) return;
    document.getElementById('studentName').value=s.name; document.getElementById('studentClass').value=s.class||'';
    document.getElementById('studentPhone').value=s.phone||''; document.getElementById('studentFee').value=s.fee||'';
    document.getElementById('studentNotes').value=s.notes||''; document.getElementById('studentEditId').value=s.id;
    document.getElementById('deleteStudentBtn').style.display='block'; document.getElementById('addStudentModal').classList.add('active');
}

function saveStudent() {
    const n = document.getElementById('studentName').value.trim(); if(!n) return showToast('Name required','error');
    const id = document.getElementById('studentEditId').value;
    const d = { id: id||'stu_'+Date.now(), name:n, class:document.getElementById('studentClass').value, phone:document.getElementById('studentPhone').value, fee:parseInt(document.getElementById('studentFee').value)||0, notes:document.getElementById('studentNotes').value };
    if(id) { students[students.findIndex(x=>x.id===id)]=d; activityLog.unshift({text:'Profile updated: '+n, time:new Date().toISOString()}); } 
    else { students.push(d); activityLog.unshift({text:'Profile generated: '+n, time:new Date().toISOString()}); }
    if(activityLog.length>30) activityLog.pop();
    syncToCloud(); closeModal('addStudentModal'); showToast('Profile Saved');
}

function deleteStudent() {
    const id = document.getElementById('studentEditId').value; if(!confirm('Erase target permanently?')) return;
    students = students.filter(x=>x.id!==id); delete attendance[id]; delete payments[id];
    syncToCloud(); closeModal('addStudentModal'); showToast('Target Erased');
}

function updateSelects() {
    const o = students.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
    ['attendance','fees','report'].forEach(p => { const e = document.getElementById(p+'StudentSelect'); if(e) e.innerHTML = '<option value="">-- Target --</option>'+o; });
}

function loadAttendanceCalendar() {
    currentCalendarStudent = document.getElementById('attendanceStudentSelect').value;
    document.getElementById('attendanceCalendar').style.display = currentCalendarStudent ? 'block' : 'none';
    if(currentCalendarStudent) renderCalendar();
}
function renderCalendar() {
    document.getElementById('calendarMonthYear').textContent = new Date(currentYear, currentMonth).toLocaleString('default', {month:'long', year:'numeric'});
    const fDay = new Date(currentYear, currentMonth, 1).getDay(); const dInM = new Date(currentYear, currentMonth+1, 0).getDate();
    let html = ''; for(let i=0; i<fDay; i++) html+='<div></div>';
    const at = attendance[currentCalendarStudent]||{};
    for(let d=1; d<=dInM; d++) {
        const ds = `${currentYear}-${String(currentMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        let st = at[ds]; let cls = 'day-cell'; if(st==='present') cls+=' present'; else if(st==='absent') cls+=' absent';
        html+=`<div class="${cls}" onclick="toggleAtt('${ds}')">${d}</div>`;
    }
    document.getElementById('calendarGrid').innerHTML = html;
}
function changeMonth(d) { currentMonth+=d; if(currentMonth>11){currentMonth=0;currentYear++;} else if(currentMonth<0){currentMonth=11;currentYear--;} renderCalendar(); }
function toggleAtt(ds) {
    if(!currentCalendarStudent) return; if(!attendance[currentCalendarStudent]) attendance[currentCalendarStudent]={};
    let cur = attendance[currentCalendarStudent][ds]; attendance[currentCalendarStudent][ds] = !cur ? 'present' : cur==='present' ? 'absent' : null;
    if(!attendance[currentCalendarStudent][ds]) delete attendance[currentCalendarStudent][ds];
    syncToCloud();
}

function loadFeesDetails() {
    const id = document.getElementById('feesStudentSelect').value; document.getElementById('feesDetails').style.display = id ? 'block' : 'none';
    if(!id) return; const s = students.find(x=>x.id===id); const pd = (payments[id]||[]).reduce((x,y)=>x+y.amount,0);
    document.getElementById('totalFees').textContent = s.fee||0; document.getElementById('paidFees').textContent = pd; document.getElementById('dueFees').textContent = Math.max(0,(s.fee||0)-pd);
    document.getElementById('paymentHistory').innerHTML = (payments[id]||[]).slice().reverse().map((p,i) => `<div style="display:flex;justify-content:space-between;padding:12px;background:var(--app-bg);border-radius:12px;margin-bottom:8px"><div style="color:var(--success);font-weight:bold">+ ₹${p.amount} <span style="color:var(--gray);font-size:0.8rem;margin-left:10px">${p.date}</span></div><button class="btn-small btn-danger" onclick="delPay('${id}',${(payments[id].length-1)-i})">X</button></div>`).join('') || '<p style="color:var(--gray)">No transactions</p>';
}
function addPayment() {
    const id = document.getElementById('feesStudentSelect').value; const amt = parseInt(document.getElementById('paymentAmount').value);
    if(!id || !amt) return showToast('Invalid amount','error');
    if(!payments[id]) payments[id]=[]; payments[id].push({amount:amt, date:document.getElementById('paymentDate').value});
    activityLog.unshift({text:`Funds received: ₹${amt}`, time:new Date().toISOString()}); if(activityLog.length>30) activityLog.pop();
    syncToCloud(); document.getElementById('paymentAmount').value=''; showToast('Transaction Confirmed');
}
function delPay(id, i) { if(!confirm('Void transaction?')) return; payments[id].splice(i,1); syncToCloud(); }

function updateReportOptions() { const t = document.getElementById('reportType').value; document.getElementById('reportStudentGroup').style.display = t==='student'?'block':'none'; document.getElementById('reportMonthGroup').style.display = t==='monthly'?'block':'none'; }
function generateReport() {
    const t = document.getElementById('reportType').value; const sid = document.getElementById('reportStudentSelect').value; const mo = document.getElementById('reportMonth').value;
    if(!t) return showToast('Define Vector','error');
    let txt = `=== CORE DATA EXTRACT ===\nTIME: ${new Date().toLocaleString()}\n\n`;
    if(t==='student') {
        if(!sid) return showToast('Target missing','error');
        const s = students.find(x=>x.id===sid); const pd = (payments[sid]||[]).reduce((x,y)=>x+y.amount,0);
        txt+=`SUBJECT: ${s.name}\nGRADE: ${s.class||'N/A'}\nCOMMS: ${s.phone||'N/A'}\n\nFINANCE DATA:\nExpected: ₹${s.fee||0}\nRecovered: ₹${pd}\nDeficit: ₹${Math.max(0,(s.fee||0)-pd)}`;
    } else if(t==='monthly') {
        if(!mo) return showToast('Define timeline','error');
        txt+=`TIMELINE REVENUE [${mo}]\n\n`; students.forEach(s => { const pd = (payments[s.id]||[]).filter(p=>p.date.startsWith(mo)).reduce((x,y)=>x+y.amount,0); txt+=`>> ${s.name}: ₹${pd} recovered\n`; });
    }
    currentReport = txt; document.getElementById('reportPreview').value = txt; document.getElementById('reportResult').style.display = 'block';
}
function shareReport(m) { window.open(`https://wa.me/?text=${encodeURIComponent(currentReport)}`); }

function backupData() { const d = JSON.stringify({students, attendance, payments, activityLog, appPassword}); navigator.clipboard.writeText(d).then(() => showToast('Payload Copied to Clipboard!')); }
function showRestoreModal() { document.getElementById('restoreData').value=''; document.getElementById('restoreModal').classList.add('active'); }
function restoreDataNow() {
    try {
        const d = JSON.parse(document.getElementById('restoreData').value);
        if(d.students) students=d.students; if(d.attendance) attendance=d.attendance;
        if(d.payments) payments=d.payments; if(d.activityLog) activityLog=d.activityLog;
        if(d.appPassword) appPassword=d.appPassword;
        syncToCloud(); showToast('Overwrite Complete. Rebooting...'); setTimeout(() => location.reload(), 1500);
    } catch(e) { showToast('Payload Corrupted','error'); }
}
function resetApp() { if(confirm('INITIATE NUKE PROTOCOL? ALL DATA WILL BURN.')) { db.ref('ChandanSirProData').remove(); localStorage.clear(); location.reload(); } }
function closeModal(id) { document.getElementById(id).classList.remove('active'); }
</script>
