<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#2563eb">
<title>Chandan Sir Tuition Pro Max</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;font-family:'Plus Jakarta Sans',sans-serif;transition:background-color 0.3s, color 0.3s}
:root{--primary:#2563eb;--primary-dark:#1d4ed8;--secondary:#f59e0b;--success:#10b981;--danger:#ef4444;--warning:#fbbf24;--dark:#0f172a;--gray:#64748b;--light:#f8fafc;--white:#ffffff;--card-bg:#ffffff;--text-main:#0f172a;--border:#e2e8f0;--app-bg:#f1f5f9}

/* Themes */
body.dark-mode{--app-bg:#0f172a;--card-bg:#1e293b;--text-main:#f8fafc;--white:#1e293b;--dark:#f8fafc;--gray:#94a3b8;--border:#334155}
body.matrix-mode{--app-bg:#000000;--card-bg:#0a0a0a;--text-main:#00ff00;--primary:#00ff00;--primary-dark:#00cc00;--secondary:#00ff00;--white:#0a0a0a;--dark:#00ff00;--gray:#008800;--border:#00ff00;--success:#00ff00;--danger:#ff0000;font-family:monospace !important}
body.matrix-mode *{font-family:monospace !important;border-radius:0 !important;box-shadow:none !important}

body{background:var(--app-bg);color:var(--text-main);min-height:100vh;overflow-x:hidden}

.splash{position:fixed;top:0;left:0;width:100%;height:100%;background:linear-gradient(135deg,var(--primary-dark),var(--primary));display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10000;transition:opacity 0.5s ease;color:#fff}
.splash.hidden{opacity:0;pointer-events:none}
.logo-frame{width:120px;height:120px;border-radius:50%;border:4px solid var(--secondary);background:var(--white);display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:20px;box-shadow:0 10px 30px rgba(0,0,0,0.3);color:var(--primary);font-size:2.5rem;font-weight:800}
.logo-frame img{width:100%;height:100%;object-fit:cover}

.login-screen{display:none;min-height:100vh;background:linear-gradient(135deg,var(--primary-dark),var(--primary));padding:20px;align-items:center;justify-content:center}
.login-screen.active{display:flex}
.login-card{background:var(--card-bg);border-radius:24px;padding:40px 25px;width:100%;max-width:380px;text-align:center;box-shadow:0 20px 40px rgba(0,0,0,0.2)}

.input-group{margin-bottom:18px;text-align:left}
.input-group label{display:block;font-size:0.85rem;font-weight:700;color:var(--gray);margin-bottom:8px}
.input-group input, .input-group select, .input-group textarea{width:100%;padding:14px 16px;border:2px solid var(--border);border-radius:12px;font-size:1rem;background:var(--app-bg);color:var(--text-main);outline:none}
.input-group input:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(37,99,235,0.15)}

.btn{width:100%;padding:15px;border:none;border-radius:14px;font-size:1rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:10px;color:#fff}
.btn:active{transform:scale(0.97)}
.btn-primary{background:var(--primary);box-shadow:0 4px 15px rgba(37,99,235,0.3)}
.btn-success{background:var(--success)}
.btn-danger{background:var(--danger)}
.btn-warning{background:var(--warning)}
.btn-secondary{background:var(--app-bg);color:var(--text-main);border:2px solid var(--border)}
.btn-small{padding:8px 16px;font-size:0.85rem;width:auto;border-radius:10px}

.app-container{display:none;padding-bottom:90px}
.app-container.active{display:block}
.app-header{background:linear-gradient(135deg,var(--primary-dark),var(--primary));color:white;padding:25px 20px 40px;position:sticky;top:0;z-index:100;border-radius:0 0 30px 30px;box-shadow:0 10px 20px rgba(37,99,235,0.2)}
.header-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}
.header-brand{display:flex;align-items:center;gap:15px;cursor:pointer}
.header-avatar{width:50px;height:50px;border-radius:50%;border:2px solid var(--secondary);background:var(--white);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:bold;overflow:hidden}
.header-avatar img{width:100%;height:100%;object-fit:cover}

.quick-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.stat-item{background:rgba(255,255,255,0.2);backdrop-filter:blur(10px);border-radius:16px;padding:15px 5px;text-align:center}
.stat-item h3{font-size:1.4rem;font-weight:800;margin-bottom:2px}
.stat-item p{font-size:0.65rem;text-transform:uppercase;font-weight:600;opacity:0.9}

.tab-content{display:none;padding:20px;animation:slideIn 0.3s ease}
.tab-content.active{display:block}
@keyframes slideIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}

.card{background:var(--card-bg);border-radius:24px;padding:22px;margin-bottom:20px;box-shadow:0 4px 20px rgba(0,0,0,0.03);border:1px solid var(--border)}
.card-title{font-size:1.15rem;font-weight:800;color:var(--text-main);margin-bottom:20px;display:flex;align-items:center;gap:10px}

.quick-actions{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}
.action-btn{background:var(--app-bg);border:2px solid var(--border);border-radius:18px;padding:20px 10px;display:flex;flex-direction:column;align-items:center;gap:12px;cursor:pointer;color:var(--text-main)}
.action-btn .icon{font-size:2.2rem}
.action-btn span{font-size:0.9rem;font-weight:700}

.student-item{background:var(--card-bg);border-radius:20px;padding:18px;margin-bottom:15px;border-left:5px solid var(--primary);box-shadow:0 4px 15px rgba(0,0,0,0.02);border:top:1px solid var(--border);border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
.badge{padding:6px 12px;border-radius:8px;font-size:0.75rem;font-weight:700;display:inline-block}
.whatsapp-btn{background:#25D366;color:white;padding:8px 14px;border-radius:10px;text-decoration:none;font-size:0.85rem;font-weight:700;display:inline-flex;align-items:center;gap:6px;margin-top:10px}
.id-btn{background:var(--primary);color:white;padding:8px 14px;border-radius:10px;font-size:0.85rem;font-weight:700;display:inline-flex;align-items:center;gap:6px;margin-top:10px;cursor:pointer;border:none}

.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:var(--card-bg);display:flex;justify-content:space-around;padding:15px 0 20px;box-shadow:0 -10px 30px rgba(0,0,0,0.05);z-index:1000;border-radius:30px 30px 0 0;border-top:1px solid var(--border)}
.nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;background:none;border:none;color:var(--gray);font-size:0.75rem;font-weight:700;cursor:pointer}
.nav-item .nav-icon{font-size:1.6rem}
.nav-item.active{color:var(--primary)}
.nav-item.active .nav-icon{transform:translateY(-5px)}

.modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);backdrop-filter:blur(5px);z-index:2000;align-items:flex-end}
.modal-overlay.active{display:flex}
.modal-sheet{background:var(--card-bg);border-radius:30px 30px 0 0;padding:30px 25px;width:100%;max-height:85vh;overflow-y:auto}

.toast-container{position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:3000;display:flex;flex-direction:column;gap:10px;width:90%;max-width:400px}
.toast{background:var(--dark);color:white;padding:16px 24px;border-radius:16px;font-size:0.95rem;font-weight:600;box-shadow:0 10px 25px rgba(0,0,0,0.2);display:flex;align-items:center;gap:12px;animation:toastIn 0.3s ease}
@keyframes toastIn{from{transform:translateY(-20px);opacity:0}to{transform:translateY(0);opacity:1}}

.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}
.day-cell{aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:12px;font-size:1rem;font-weight:700;background:var(--app-bg)}
.day-cell.present{background:var(--success);color:white}
.day-cell.absent{background:var(--danger);color:white}

.fab{position:fixed;bottom:105px;right:25px;width:65px;height:65px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--secondary));color:white;border:none;font-size:2.5rem;font-weight:300;box-shadow:0 10px 25px rgba(37,99,235,0.4);z-index:100;display:flex;align-items:center;justify-content:center}

/* Secret Hacker Box */
.secret-hacker-box{background:#000;border:2px solid #0f0;color:#0f0;padding:20px;border-radius:10px;font-family:monospace;margin-top:20px}
.secret-btn{background:transparent;border:1px solid #0f0;color:#0f0;padding:10px;width:100%;margin-bottom:10px;cursor:pointer;font-family:monospace;text-transform:uppercase}
.secret-btn:hover{background:#0f0;color:#000}

/* Digital ID Card Styling */
.digital-id-card{background:linear-gradient(135deg,var(--primary-dark),var(--primary));border-radius:20px;padding:25px 20px;color:white;text-align:center;box-shadow:0 10px 30px rgba(37,99,235,0.4);position:relative;overflow:hidden;margin-bottom:20px}
.digital-id-card::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);z-index:0}
.digital-id-content{position:relative;z-index:1}
.id-photo{width:100px;height:100px;border-radius:50%;border:4px solid var(--secondary);margin:0 auto 15px;background:white;display:flex;align-items:center;justify-content:center;font-size:2rem;color:var(--primary);font-weight:bold;overflow:hidden}
.id-photo img{width:100%;height:100%;object-fit:cover}
</style>
</head>
<body>
<div class="toast-container" id="toastContainer"></div>

<div class="splash" id="splashScreen">
    <div class="logo-frame"><img src="" class="app-logo-img" alt="CS" onerror="this.style.display='none'; this.parentNode.innerHTML='CS';"></div>
    <h1 style="font-weight:800;font-size:1.8rem;text-shadow:0 2px 5px rgba(0,0,0,0.3)">Chandan Sir</h1>
    <p style="opacity:0.9;font-weight:600;letter-spacing:2px">PRO MANAGER</p>
    <div style="position:absolute;bottom:40px;font-size:0.8rem;opacity:0.8">Engineered by <strong style="color:var(--secondary);font-size:1rem">Raunak Kumar</strong></div>
</div>

<div class="login-screen" id="loginScreen">
    <div class="login-card">
        <div class="logo-frame" style="margin:0 auto 25px;width:90px;height:90px;font-size:2rem"><img src="" class="app-logo-img" alt="CS" onerror="this.style.display='none'; this.parentNode.innerHTML='CS';"></div>
        <h2 style="font-weight:800">Secure Access</h2>
        <p style="color:var(--gray);font-size:0.9rem;margin-bottom:30px">Enter master password to unlock</p>
        <div class="input-group"><input type="password" id="loginPassword" placeholder="Password"></div>
        <button class="btn btn-primary" onclick="login()">Unlock Dashboard</button>
    </div>
</div>

<div class="app-container" id="mainApp">
    <div class="app-header">
        <div class="header-top">
            <div class="header-brand" onclick="secretTrigger()">
                <div class="header-avatar"><img src="" class="app-logo-img" alt="CS" onerror="this.style.display='none'; this.parentNode.innerHTML='CS';"></div>
                <div><h1 style="font-size:1.3rem;font-weight:800">Chandan Sir</h1><p style="font-size:0.8rem;opacity:0.8;font-weight:500">Pro Dashboard</p></div>
            </div>
            <button class="btn-icon" onclick="logout()" style="background:rgba(255,255,255,0.15);color:white;border:none;padding:10px 15px;border-radius:12px;font-weight:700">Exit</button>
        </div>
        <div class="quick-stats">
            <div class="stat-item"><h3 id="totalStudents">0</h3><p>Total</p></div>
            <div class="stat-item"><h3 id="todayPresent">0</h3><p>Present</p></div>
            <div class="stat-item"><h3 id="todayAbsent">0</h3><p>Absent</p></div>
            <div class="stat-item"><h3 id="feesDue">0</h3><p>Fee Due</p></div>
        </div>
    </div>

    <div id="tab-dashboard" class="tab-content active">
        <div class="card">
            <div class="card-title">⚡ Command Center</div>
            <div class="quick-actions">
                <button class="action-btn" onclick="openAddStudent()"><div class="icon">👨‍🎓</div><span>New Student</span></button>
                <button class="action-btn" onclick="switchTab('attendance')"><div class="icon">📝</div><span>Attendance</span></button>
                <button class="action-btn" onclick="switchTab('fees')"><div class="icon">💰</div><span>Finance</span></button>
                <button class="action-btn" onclick="switchTab('reports')"><div class="icon">📈</div><span>Analytics</span></button>
            </div>
        </div>
        <div class="card"><div class="card-title">🕒 Live Feed</div><div id="recentActivity" style="font-size:0.9rem"></div></div>
    </div>

    <div id="tab-students" class="tab-content">
        <input type="text" class="search-bar" id="studentSearch" placeholder="🔍 Search students..." onkeyup="searchStudents()" style="width:100%;padding:18px;border-radius:16px;border:2px solid var(--border);background:var(--card-bg);color:var(--text-main);margin-bottom:20px;font-weight:600">
        <div id="studentsList"></div>
    </div>

    <div id="tab-attendance" class="tab-content">
        <div class="card">
            <div class="input-group">
                <label>Target Student</label>
                <select id="attendanceStudentSelect" onchange="loadAttendanceCalendar()"><option value="">-- Choose Target --</option></select>
            </div>
        </div>
        <div id="attendanceCalendar" style="display:none" class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px">
                <button class="btn-secondary" style="padding:8px 20px;border-radius:10px" onclick="changeMonth(-1)">◀</button>
                <h3 id="calendarMonthYear" style="font-weight:800;color:var(--text-main)"></h3>
                <button class="btn-secondary" style="padding:8px 20px;border-radius:10px" onclick="changeMonth(1)">▶</button>
            </div>
            <button class="btn btn-success" style="margin-bottom:20px;padding:10px" onclick="markAllPresentRegular()">✅ Mark All Present Today</button>
            
            <div class="calendar-grid" style="color:var(--gray);font-size:0.85rem;text-align:center;margin-bottom:12px;font-weight:700">
                <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
            </div>
            <div class="calendar-grid" id="calendarGrid"></div>
        </div>
    </div>

    <div id="tab-fees" class="tab-content">
        <div class="card"><div class="input-group"><label>Target Student</label><select id="feesStudentSelect" onchange="loadFeesDetails()"><option value="">-- Choose Target --</option></select></div></div>
        <div id="feesDetails" style="display:none">
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-bottom:20px">
                <div style="background:var(--card-bg);padding:20px 10px;border-radius:20px;text-align:center;border:2px solid var(--primary)"><h3 id="totalFees" style="color:var(--primary);font-size:1.5rem">0</h3><p style="font-size:0.7rem;font-weight:700;color:var(--gray)">EXPECTED</p></div>
                <div style="background:var(--card-bg);padding:20px 10px;border-radius:20px;text-align:center;border:2px solid var(--success)"><h3 id="paidFees" style="color:var(--success);font-size:1.5rem">0</h3><p style="font-size:0.7rem;font-weight:700;color:var(--gray)">RECOVERED</p></div>
                <div style="background:var(--card-bg);padding:20px 10px;border-radius:20px;text-align:center;border:2px solid var(--danger)"><h3 id="dueFees" style="color:var(--danger);font-size:1.5rem">0</h3><p style="font-size:0.7rem;font-weight:700;color:var(--gray)">DEFICIT</p></div>
            </div>
            <div class="card">
                <div class="card-title">💳 Inject Funds</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px">
                    <div class="input-group"><input type="number" id="paymentAmount" placeholder="Amount ₹"></div>
                    <div class="input-group"><input type="date" id="paymentDate"></div>
                </div>
                <button class="btn btn-primary" onclick="addPayment()">Process Transaction</button>
            </div>
            <div class="card"><div class="card-title">📜 Ledger History</div><div id="paymentHistory"></div></div>
        </div>
    </div>

    <div id="tab-reports" class="tab-content">
        <div class="card">
            <div class="card-title">📊 Data Extraction</div>
            <div class="input-group">
                <select id="reportType" onchange="updateReportOptions()">
                    <option value="">-- Select Report Vector --</option>
                    <option value="student">Deep Student Profiling</option>
                    <option value="monthly">Monthly Revenue & Attendance</option>
                </select>
            </div>
            <div class="input-group" id="reportStudentGroup" style="display:none"><select id="reportStudentSelect"><option value="">-- Target --</option></select></div>
            <div class="input-group" id="reportMonthGroup" style="display:none"><input type="month" id="reportMonth"></div>
            <div style="display:flex;gap:10px">
                <button class="btn btn-primary" onclick="generateReport()">Extract Data</button>
                <button class="btn btn-success" onclick="exportToCSV()" style="white-space:nowrap">📥 Export Excel</button>
            </div>
        </div>
        <div id="reportResult" style="display:none">
            <textarea id="reportPreview" readonly style="width:100%;height:300px;background:var(--card-bg);color:var(--text-main);padding:15px;border-radius:15px;border:2px solid var(--border);font-family:monospace;font-size:0.85rem;margin-bottom:15px"></textarea>
            <button class="btn btn-success" onclick="shareReport('whatsapp')">Deploy via WhatsApp</button>
        </div>
    </div>

    <div id="tab-settings" class="tab-content">
        <div class="card">
            <div class="card-title">⚙️ System Configuration</div>
            
            <div style="padding:15px 0;border-bottom:1px solid var(--border)">
                <h4 style="font-size:0.95rem;margin-bottom:10px">Security (Change Password) 🔐</h4>
                <div class="input-group" style="margin-bottom:10px"><input type="password" id="oldPass" placeholder="Current Password"></div>
                <div class="input-group" style="margin-bottom:10px"><input type="password" id="newPass" placeholder="New Password"></div>
                <button class="btn-small btn-primary" onclick="changeAppPassword()">Update Password</button>
            </div>

            <div style="padding:15px 0;border-bottom:1px solid var(--border)">
                <h4 style="font-size:0.95rem;margin-bottom:10px">Upload Custom Logo 📸</h4>
                <input type="file" id="logoUpload" accept="image/*" onchange="handleLogoUpload(event)" style="font-size:0.8rem;width:100%">
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid var(--border)">
                <div><h4 style="font-size:0.95rem">Dark Mode 🌙</h4></div>
                <button class="btn-small btn-secondary" onclick="toggleTheme()" id="themeBtn">Toggle</button>
            </div>

            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid var(--border)">
                <div><h4 style="font-size:0.95rem">Backup Core Data</h4></div>
                <button class="btn-small btn-primary" onclick="backupData()">Export</button>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid var(--border)">
                <div><h4 style="font-size:0.95rem">Restore Core Data</h4></div>
                <button class="btn-small btn-success" onclick="showRestoreModal()">Import</button>
            </div>
            <div style="padding:15px 0">
                <button class="btn btn-danger" onclick="resetApp()">🔥 Nuke System (Delete All)</button>
            </div>
        </div>
    </div>

    <div class="bottom-nav">
        <button class="nav-item active" onclick="switchTab('dashboard')"><div class="nav-icon">🏠</div><span>HQ</span></button>
        <button class="nav-item" onclick="switchTab('students')"><div class="nav-icon">👥</div><span>Intel</span></button>
        <button class="nav-item" onclick="switchTab('attendance')"><div class="nav-icon">📅</div><span>Logs</span></button>
        <button class="nav-item" onclick="switchTab('fees')"><div class="nav-icon">💸</div><span>Funds</span></button>
        <button class="nav-item" onclick="switchTab('reports')"><div class="nav-icon">📊</div><span>Data</span></button>
        <button class="nav-item" onclick="switchTab('settings')"><div class="nav-icon">⚙️</div><span>Sys</span></button>
    </div>
    <button class="fab" onclick="openAddStudent()">+</button>
</div>

<div class="modal-overlay" id="addStudentModal">
    <div class="modal-sheet">
        <div class="modal-header"><h3>Student Profile Setup</h3><button class="modal-close" onclick="closeModal('addStudentModal')">&times;</button></div>
        <div class="input-group"><label>Full Name</label><input type="text" id="studentName"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px">
            <div class="input-group"><label>Grade/Class</label><input type="text" id="studentClass"></div>
            <div class="input-group"><label>Expected Fee (₹)</label><input type="number" id="studentFee"></div>
        </div>
        <div class="input-group"><label>Comms (WhatsApp)</label><input type="tel" id="studentPhone" placeholder="+91"></div>
        <div class="input-group"><label>Classified Notes</label><textarea id="studentNotes" placeholder="Performance, warnings, etc."></textarea></div>
        <input type="hidden" id="studentEditId">
        <button class="btn btn-primary" onclick="saveStudent()">Initialize Profile</button>
        <button class="btn btn-danger" id="deleteStudentBtn" style="margin-top:15px;display:none" onclick="deleteStudent()">Terminate Profile</button>
    </div>
</div>

<div class="modal-overlay" id="idCardModal">
    <div class="modal-sheet" style="background:transparent;box-shadow:none">
        <div class="digital-id-card" id="digitalIdContent">
            <div class="digital-id-content">
                <h3 style="font-size:1.5rem;margin-bottom:5px;font-weight:800;letter-spacing:1px">CHANDAN SIR TUITION</h3>
                <p style="font-size:0.75rem;opacity:0.8;margin-bottom:20px;letter-spacing:2px">OFFICIAL STUDENT ID</p>
                <div class="id-photo"><img id="idCardLogo" src="" onerror="this.style.display='none'; this.parentNode.innerHTML='👤';"></div>
                <h2 id="idCardName" style="font-size:1.8rem;margin-bottom:5px">Student Name</h2>
                <p id="idCardClass" style="font-size:1rem;opacity:0.9;margin-bottom:20px">Class: 10th</p>
